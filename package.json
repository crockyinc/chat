{
  "name": "lan-messenger",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cloud LAN messenger with rich text, spreadsheets, images and real-time sync",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./client/styles/tailwind.css -o ./public/css/app.css --minify",
    "build:js": "esbuild client/main.js --bundle --format=iife --target=es2020 --outfile=public/js/app.js --sourcemap",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "node scripts/dev.js",
    "pages:deploy": "npm run build:pages && wrangler pages deploy dist",
    "pages:dev": "npm run build:pages && wrangler pages dev dist",
    "prestart": "npm run build",
    "seed": "node scripts/seed.js",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --test --test-force-exit tests/server.test.js",
    "test:ui": "npm run build && node --test --test-force-exit --experimental-import-meta-resolve tests/ui.test.js",
    "verify": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.160.0"
  }
}
